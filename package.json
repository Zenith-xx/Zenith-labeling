{
  "name": "labeling-vue3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:embed": "vite --base /icms4ci/static/labeling-dev/",
    "dev:tunnel": "vite --mode tunnel",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check": "vue-tsc -b --noEmit",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "verify": "npm run test && npm run typecheck && npm run build",
    "verify:idb": "node scripts/verify-indexeddb.mjs",
    "verify:history": "node scripts/verify-history-v2.mjs",
    "verify:shortcut": "node scripts/verify-label-shortcut.mjs",
    "verify:import": "node scripts/verify-import.mjs",
    "verify:import-pure": "node scripts/verify-import-pure.mjs",
    "verify:label-discovery": "node scripts/verify-label-discovery.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "konva": "^9.3.18",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^3.0.1",
    "rbush": "^4.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/rbush": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "happy-dom": "^20.12.0",
    "vue-tsc": "^2.2.8"
  }
}
