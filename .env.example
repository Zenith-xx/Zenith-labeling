# labeling-vue3 environment variables (documentation only).
# Vite reads VITE_* at build/dev time via import.meta.env.

# Production build: browser connects directly to Labeling-Server.
# Development uses /labeling-api proxy — this variable is NOT required for npm run dev.
VITE_LABELING_SERVER_URL=http://localhost:8100

# Vite dev proxy target port (optional, default 8100)
# LABELING_PORT=8100

# Tunnel mode: npm run dev:tunnel (see .env.tunnel)
# VITE_TUNNEL_HMR=1
